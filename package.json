{
  "name": "electron_template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "electron": "electron --inspect=9229 .",
    "dev": "chcp 65001 > nul && yarn build:electron && cross-env NODE_OPTIONS='--max-old-space-size=4096' NODE_ENV=development npm-run-all -p vite:dev \"electron --js-flags=--expose-gc\"",
    "vite:dev": "vite",
    "clean": "rimraf dist dist-electron release",
    "build": "yarn clean && vite build --mode development && yarn build-only && yarn build:electron && cross-env APP_ENV=development electron-builder",
    "build:prod": "yarn clean && vite build --mode prod && yarn build-only && yarn build:electron && cross-env APP_ENV=prod electron-builder",
    "build-only": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/ electron/"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "dayjs": "^1.11.19",
    "decimal.js": "^10.6.0",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.7.3",
    "exceljs": "^4.4.0",
    "lodash": "^4.17.23",
    "pako": "^2.1.0",
    "pinia": "^3.0.4",
    "postcss-pxtorem": "^6.1.0",
    "rxjs": "^7.8.2",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/exceljs": "^1.3.2",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.10.4",
    "@types/pako": "^2.0.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/tsconfig": "^0.8.1",
    "ant-design-vue": "4.x",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "electron-icon-builder": "^2.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.7.4",
    "rimraf": "^6.1.2",
    "sass": "^1.97.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.2"
  },
  "build": {
    "extends": "./build.config.js"
  }
}
