{
  "name": "electron_template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "electron": "electron .",
    "dev": "cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:3000 npm-run-all -p vite:dev electron",
    "vite:dev": "vite",
    "build": "yarn build-only && yarn build:electron && electron-builder",
    "build-only": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "electron-store": "^11.0.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/tsconfig": "^0.8.1",
    "ant-design-vue": "4.x",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.7.4",
    "sass": "^1.97.2",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.2"
  },
  "build": {
    "extends": "./build.config.js"
  }
}
